# Demonstrates key combinations using the evp helper tool.

Output keys.gif
Output keys.svg

Set Shell ./target/x86_64-unknown-linux-musl/release/evp_helper_tool key
Set Width 900
Set Height 400
Set FontSize 18
Set TypingSpeed 40ms
Set Framerate 30

Sleep 500ms

# Run the modifier key combinations
Ctrl+Shift+Alt+Left
Sleep 1s
Command+Alt+PageUp
Sleep 1.5s
